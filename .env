# ============================================================
# DOCUMENT PROCESSING
# ============================================================

MAX_PAGES=1000
OCR_DPI=200
MIN_TEXT_LENGTH=30


# ============================================================
# PRIMARY OCR - PaddleOCR-VL
# ============================================================

PADDLE_ENABLED=true

PADDLE_PIPELINE_VERSION=v1.6

# Leave empty to let PaddleOCR choose the device.
#
# GPU example:
# PADDLE_DEVICE=gpu:0
#
# CPU:
# PADDLE_DEVICE=cpu
#
PADDLE_DEVICE=auto


# ============================================================
# OCR QUALITY
# ============================================================

OCR_CONFIDENCE_THRESHOLD=0.80


# ============================================================
# FALLBACK OCR - Unlimited-OCR
# ============================================================

UNLIMITED_OCR_ENABLED=true

UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR

# Official high-level Transformers inference path.
#
# Options:
#   pipeline
#   model
#
# Recommended:
UNLIMITED_OCR_MODE=pipeline

# Model placement.
#
# Recommended:
MODEL_DEVICE=auto


# ============================================================
# HUGGING FACE
# ============================================================

# Unlimited-OCR is publicly available.
# Leave empty unless your environment requires authentication.

HF_TOKEN=


# ============================================================
# QWEN3-VL SUPERVISOR
# ============================================================

SUPERVISOR_ENABLED=true

SUPERVISOR_MODEL=Qwen/Qwen3-VL-8B-Instruct

SUPERVISOR_ON_CONFLICT=true

SUPERVISOR_CONFIDENCE_THRESHOLD=0.90


# ============================================================
# FINANCIAL VALIDATION
# ============================================================

AMOUNT_TOLERANCE=0.01


# ============================================================
# SAFETY
# ============================================================

# NEVER enable invented master-data values.
#
# This is intentionally not configurable in settings.py.
# The application permanently uses:
#
# ALLOW_INVENTED_MASTER_VALUES=False


# ============================================================
# EVIDENCE
# ============================================================

STORE_EVIDENCE=true


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO